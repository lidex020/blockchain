# Systemd unit: LIDEX CometBFT ABCI++ application for public Testnet.
#
# Hosts the ABCI++ socket application (execution + journal) and the EVM
# JSON-RPC/WS/explorer HTTP surface on loopback port 7302. CometBFT owns
# consensus; this process never runs the custom consensus engine and never
# serves /p2p/* routes.
#
# Requires:
#   - Approved testnet genesis file (offline ceremony output)
#   - Verified lidex-comet-validator-map-v1 validator mapping
#   - CometBFT running on loopback (26657 RPC, 26658 ABCI)
#
#   sudo systemctl enable --now lidex-abci-testnet.service

[Unit]
Description=LIDEX ABCI++ application (Testnet)
After=network.target lidex-cometbft-testnet.service
Wants=network.target
Requires=lidex-cometbft-testnet.service

[Service]
Type=simple
User=lidex
Group=lidex
WorkingDirectory=/workspaces/lidex
Environment=LIDEX_NETWORK=testnet
Environment=LIDEX_COMET_RPC_URL=http://127.0.0.1:26657
Environment=LIDEX_ABCI_LISTEN=tcp://127.0.0.1:26658
Environment=LIDEX_ABCI_DATADIR=/srv/lidex/testnet/abci
Environment=LIDEX_GENESIS=/srv/lidex/testnet/genesis.json
Environment=LIDEX_VALIDATOR_MAP=/srv/lidex/testnet/validator-map.json
Environment=LIDEX_RPC_PORT=7302
Environment=LIDEX_RPC_HOST=127.0.0.1
# Faucet key for testnet only (operator-provided, testnet funds only).
Environment=LIDEX_FAUCET_KEY=
Environment=LIDEX_RPC_RATE_LIMIT=1200
ExecStart=/usr/bin/node /workspaces/lidex/src/abci/serve.js \
  --genesis ${LIDEX_GENESIS} \
  --validator-map ${LIDEX_VALIDATOR_MAP} \
  --datadir ${LIDEX_ABCI_DATADIR} \
  --listen ${LIDEX_ABCI_LISTEN} \
  --rpc-port ${LIDEX_RPC_PORT} \
  --rpc-host ${LIDEX_RPC_HOST} \
  --comet-rpc-url ${LIDEX_COMET_RPC_URL} \
  --rpc-rate-limit ${LIDEX_RPC_RATE_LIMIT} \
  ${LIDEX_FAUCET_KEY:+--faucet-key ${LIDEX_FAUCET_KEY}}
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/srv/lidex/testnet/abci

[Install]
WantedBy=multi-user.target
