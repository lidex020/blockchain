# Systemd unit for the LIDEX CometBFT ABCI application (%i = network).
#
# Hosts the ABCI++ socket application (execution + journal) and, when
# LIDEX_RPC_PORT is set, the EVM JSON-RPC/WS/explorer surface served from the
# same Chain instance. CometBFT owns consensus; this process never runs the
# custom consensus engine and never serves /p2p/* routes.
#
# The ABCI socket listens loopback only. The RPC port (7301 mainnet, 7302
# testnet) is consumed by nginx (and optionally the public gateway).
#
# Requires an approved genesis file and validator mapping
# (lidex-comet-validator-map-v1), produced by a genesis ceremony. Never supply
# devnet/mainnet identifiers for a public testnet.
#
#   sudo systemctl enable --now lidex-abci@testnet.service

[Unit]
Description=LIDEX ABCI++ application (%i)
After=network.target lidex-cometbft@%i.service
Wants=network.target
Requires=lidex-cometbft@%i.service

[Service]
Type=simple
User=lidex
Group=lidex
WorkingDirectory=/workspaces/lidex
Environment=LIDEX_NETWORK=%i
Environment=LIDEX_COMET_RPC_URL=http://127.0.0.1:26657
Environment=LIDEX_ABCI_LISTEN=tcp://127.0.0.1:26658
# Network-specific dedicated ABCI data directory (never reset/adopted).
Environment=LIDEX_ABCI_DATADIR=/srv/lidex/%i/abci
# Genesis + validator map produced by the genesis ceremony (operator-provided).
Environment=LIDEX_GENESIS=/srv/lidex/%i/genesis.json
Environment=LIDEX_VALIDATOR_MAP=/srv/lidex/%i/validator-map.json
# RPC port: 7301 mainnet, 7302 testnet. Bind loopback only.
Environment=LIDEX_RPC_PORT=7302
Environment=LIDEX_RPC_HOST=127.0.0.1
# Optional: enable faucet on testnet with a funding key (testnet only).
Environment=LIDEX_FAUCET_KEY=
# JSON-RPC rate limit (requests per minute per client).
Environment=LIDEX_RPC_RATE_LIMIT=1200
ExecStart=/usr/bin/node /workspaces/lidex/src/abci/serve.js \
  --genesis ${LIDEX_GENESIS} \
  --validator-map ${LIDEX_VALIDATOR_MAP} \
  --datadir ${LIDEX_ABCI_DATADIR} \
  --listen ${LIDEX_ABCI_LISTEN} \
  --rpc-port ${LIDEX_RPC_PORT} \
  --rpc-host ${LIDEX_RPC_HOST} \
  --comet-rpc-url ${LIDEX_COMET_RPC_URL} \
  --rpc-rate-limit ${LIDEX_RPC_RATE_LIMIT} \
  ${LIDEX_FAUCET_KEY:+--faucet-key ${LIDEX_FAUCET_KEY}}
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
# Do not expose the ABCI socket or RPC to the public network directly; nginx
# (and optionally the public gateway) sit in front.

[Install]
WantedBy=multi-user.target
