{
  "name": "fullstop-blockchain",
  "version": "0.1.0",
  "description": "Full Stop Blockchain - an independent, public, EVM-compatible Layer 1 with the native coin FSTOP",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "src/node.js",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fullstop": "src/cli.js"
  },
  "scripts": {
    "compile": "node scripts/compile-contracts.js",
    "build:wallet": "esbuild web/appkit-entry.js --bundle --format=esm --target=es2022 --minify --outfile=web/appkit.bundle.js",
    "init": "node scripts/init-devnet.js",
    "start": "node src/node.js",
    "predevnet": "npm run build:wallet",
    "devnet": "node scripts/start-devnet.js",
    "faucet": "node scripts/faucet.js",
    "bench": "node scripts/benchmark.js",
    "test": "node tests/run.js",
    "acceptance": "node tests/run.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/statemanager": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-ethers": "^1.8.24",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "ethereum-cryptography": "^3.2.0",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "solc": "^0.8.37",
    "ws": "^8.22.0"
  }
}
